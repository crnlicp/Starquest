    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@icp-sdk/bindgen": "^0.4.1",
    "@react-router/dev": "^8.5.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
